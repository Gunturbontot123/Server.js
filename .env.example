PORT=3000
NODE_ENV=production
# Copy this file to .env and fill values

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apotek
# Optional when DATABASE_URL is not used:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=apotek
# PGUSER=postgres
# PGPASSWORD=postgres
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=false

# Auto-seeding (set to 'true' to auto-populate database on startup if empty)
# Useful for development/staging environments
AUTO_SEED=false

SESSION_SECRET=replace-with-strong-random-secret
SESSION_COOKIE_SECURE=false
APP_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=yourpassword
NOTIFY_FROM=you@example.com
NOTIFY_TO=recipient@example.com