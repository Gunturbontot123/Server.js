PORT=3000
# Copy this file to .env and fill values
DATABASE_URL=postgres://postgres:postgres@localhost:5432/apotek
# Optional when DATABASE_URL is not used:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=apotek
# PGUSER=postgres
# PGPASSWORD=postgres
# PG_SSL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=yourpassword
NOTIFY_FROM=you@example.com
NOTIFY_TO=recipient@example.com